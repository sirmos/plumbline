# Copy this file to .env (same folder) and fill in the keys you have. .env is never committed.
# Every key below is free. Each one you add is another provider to fall back on, so the app keeps
# working when one is busy, down, or has retired a model. Plumb Line finds each provider's current
# models by itself, so you do not need to put model names here.

# Groq: speech-to-text for Live Pulpit AND text AI. Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras: fast backup. https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Google Gemini: backup, strong in many languages. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter: many free models behind one key (ids ending in :free). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Privacy. Some free tiers (Gemini, Mistral, OpenRouter) may use prompts to improve their products. By default
# Plumb Line sends them only PUBLIC text (sermon captions and translations), never prayers, care requests or
# visitor questions. While you are testing with made-up data only, you can let every provider see everything:
# AI_ALLOW_TRAINING_PROVIDERS=true
# Never turn that on with real church members' information.

# Optional: put a model you prefer first, for example  GROQ_MODEL_DEFAULT=openai/gpt-oss-120b
# Optional: set a password so sign-ins survive restarts when you deploy:  SECRET=

# --- Demo church (optional) ---
# Set a passcode to create a fictional demo church called "harbor-demo" at start-up, filled with sample content,
# so judges or visitors can sign in and explore. Sign in as the pastor with church ID harbor-demo and this passcode,
# or as a team member named "Ruth Demo" with the same passcode. On a host without a disk it is re-created after a restart.
# DEMO_PASS=choose-a-passcode-of-8-or-more-characters

# --- Keep churches on a host with no disk (optional, free) ---
# Create a free Redis database at upstash.com, copy these two from its REST API section, and set SECRET above.
# Data is encrypted with a key made from SECRET before it is sent. Never change SECRET afterwards.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
